<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>A9 Strip</title>
    <organization>com.mlabs.a9strip</organization>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <license file="LICENSE"/>

    <choices-outline>
        <line choice="choice_vst3"/>
        <line choice="choice_clap"/>
    </choices-outline>

    <choice id="choice_vst3"
            title="A9 Strip VST3 Plugin"
            description="Installs A9 Strip.vst3 into /Library/Audio/Plug-Ins/VST3"
            selected="true">
        <pkg-ref id="com.mlabs.a9strip.vst3"/>
    </choice>

    <choice id="choice_clap"
            title="A9 Strip CLAP Plugin"
            description="Installs A9 Strip.clap into /Library/Audio/Plug-Ins/CLAP"
            selected="true">
        <pkg-ref id="com.mlabs.a9strip.clap"/>
    </choice>

    <pkg-ref id="com.mlabs.a9strip.vst3" version="VERSION_PLACEHOLDER">a9_strip_vst3.pkg</pkg-ref>
    <pkg-ref id="com.mlabs.a9strip.clap" version="VERSION_PLACEHOLDER">a9_strip_clap.pkg</pkg-ref>
</installer-gui-script>
